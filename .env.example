APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://healthcare:healthcare@127.0.0.1:45432/healthcare?sslmode=disable
# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=60
# Where uploaded medical reports are stored (local disk in development)
UPLOAD_DIR=./data/uploads
# Public URL of this API (used in prescription QR codes and payment callbacks)
PUBLIC_BASE_URL=http://localhost:8080
# Where patients are sent back to after paying
FRONTEND_URL=http://localhost:3000
# SSLCommerz: leave empty to use the development payment simulator
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Video calls: a TURN server (e.g. coturn) helps calls connect on networks that
# block direct connections. Leave empty to use only a public STUN server.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Platform commission on delivered pharmacy orders, in basis points (300 = 3%)
PHARMACY_COMMISSION_BPS=300
# Browser origins allowed to call the API (your frontend), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true only behind a reverse proxy (e.g. Caddy) that sets X-Real-IP
TRUST_PROXY=false
