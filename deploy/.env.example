# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Point both domains' DNS A records at the server first.
# The website people open:
WEB_DOMAIN=www.example.com
# The API (payment callbacks and prescription QR codes use it):
API_DOMAIN=api.example.com

# Database password: long and random, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Token signing secret: `openssl rand -hex 32`
JWT_SECRET=
JWT_TTL_MINUTES=60

# Other browser origins allowed to call the API directly (CORS), comma-separated.
# Leave empty: the website reaches the API through its own server.
CORS_ALLOWED_ORIGINS=

# SSLCommerz (leave the store id empty until you have an account)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

PHARMACY_COMMISSION_BPS=300
