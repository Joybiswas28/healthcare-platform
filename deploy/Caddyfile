# Caddy obtains and renews Let's Encrypt certificates for both domains automatically.

(common) {
	encode gzip

	# Uploads are capped at 10 MB by the API; leave a little room for form overhead.
	request_body {
		max_size 12MB
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# WebSocket connections carry the login token in the URL.
				request>uri query {
					delete access_token
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

# The website, which patients, doctors, pharmacies and riders open.
{$WEB_DOMAIN} {
	import common

	reverse_proxy web:3000 {
		# The website passes X-Real-IP on to the API, which trusts it
		# (TRUST_PROXY=true). Set it from the real connection and drop any copy a
		# client sent, so IPs cannot be faked.
		header_up X-Real-IP {remote_host}
		header_up -True-Client-IP
	}
}

# The API: payment callbacks, prescription QR codes and direct API clients.
{$API_DOMAIN} {
	import common

	reverse_proxy api:8080 {
		# The API trusts these headers (TRUST_PROXY=true). Set them from the real
		# connection and drop any copy a client sent, so IPs cannot be faked.
		header_up X-Real-IP {remote_host}
		header_up -True-Client-IP
	}
}
